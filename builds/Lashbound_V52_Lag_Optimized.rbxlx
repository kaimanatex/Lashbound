    <Item class="Script" referent="RBX04016">
      <Properties>
        <string name="Name">LashboundV19ChessService</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source">-- One physical chess table, two-player challenge or beginner bot.
-- Server owns the board and validates all moves, including check and castling.
local RS=game:GetService("ReplicatedStorage")
local Players=game:GetService("Players")
local Workspace=game:GetService("Workspace")
local TweenService=game:GetService("TweenService")
local PieceFactory=require(RS:WaitForChild("LashboundChessPieceFactory"))
local rng=Random.new()
local Request=RS:FindFirstChild("LashboundChessRequest") or Instance.new("RemoteEvent")
Request.Name="LashboundChessRequest";Request.Parent=RS
local State=RS:FindFirstChild("LashboundChessState") or Instance.new("RemoteEvent")
State.Name="LashboundChessState";State.Parent=RS
local lastAt={}
local function cell(r,c) return (r-1)*8+c end
local function coords(i) return math.floor((i-1)/8)+1,(i-1)%8+1 end
local function inBounds(r,c) return r&gt;=1 and r&lt;=8 and c&gt;=1 and c&lt;=8 end
local function color(p) return p and (p:match("%u") and "w" or "b") or nil end
local function initial()
    local b={}
    local back={"r","n","b","q","k","b","n","r"}
    for c=1,8 do
        b[cell(1,c)]=back[c]; b[cell(2,c)]="p"
        b[cell(7,c)]="P";b[cell(8,c)]=string.upper(back[c])
    end
    return b
end
local gameState={board=initial(),turn="w",white=nil,black=nil,mode="idle",status="Choose PvP or bot.",
    castling={K=true,Q=true,k=true,q=true}, ep=nil, ply=0, version=0, lastMove=nil, ended=false}
local tablePart=nil
local function chessPart()
    if tablePart and tablePart.Parent then return tablePart end
    local lobby=Workspace:FindFirstChild("LashboundLobby")
    tablePart=lobby and lobby:FindFirstChild("LashboundChessBoard")
    return tablePart
end
local function closeEnough(p)
    if p:GetAttribute("Zone")~="Lobby" then return false end
    local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    local tableTop=chessPart()
    return root and tableTop and (root.Position-tableTop.Position).Magnitude&lt;32
end
local dirsRook={{1,0},{-1,0},{0,1},{0,-1}}
local dirsBishop={{1,1},{1,-1},{-1,1},{-1,-1}}
local knights={{-2,-1},{-2,1},{2,-1},{2,1},{-1,-2},{-1,2},{1,-2},{1,2}}
local function squareAttacked(b,r,c,by)
    local pawn=(by=="w" and "P" or "p")
    local pawnFrom=r+(by=="w" and 1 or -1)
    for _,dc in ipairs({-1,1}) do
        if inBounds(pawnFrom,c+dc) and b[cell(pawnFrom,c+dc)]==pawn then return true end
    end
    for _,d in ipairs(knights) do
        local rr,cc=r+d[1],c+d[2]
        if inBounds(rr,cc) and b[cell(rr,cc)]==(by=="w" and "N" or "n") then return true end
    end
    for _,d in ipairs(dirsRook) do
        local rr,cc=r+d[1],c+d[2]
        for range=1,7 do
            if not inBounds(rr,cc) then break end
            local p=b[cell(rr,cc)]
            if p then
                if color(p)==by and ((p:lower()=="r" or p:lower()=="q") or (range==1 and p:lower()=="k")) then return true end
                break
            end
            rr+=d[1];cc+=d[2]
        end
    end
    for _,d in ipairs(dirsBishop) do
        local rr,cc=r+d[1],c+d[2]
        for range=1,7 do
            if not inBounds(rr,cc) then break end
            local p=b[cell(rr,cc)]
            if p then
                if color(p)==by and ((p:lower()=="b" or p:lower()=="q") or (range==1 and p:lower()=="k")) then return true end
                break
            end
            rr+=d[1];cc+=d[2]
        end
    end
    return false
end
local function inCheck(b,side)
    local king=side=="w" and "K" or "k"
    for i=1,64 do
        if b[i]==king then
            local r,c=coords(i)
            return squareAttacked(b,r,c,side=="w" and "b" or "w")
        end
    end
    return true
end
local function pseudo(g,side)
    local b=g.board;local moves={}
    local function add(fr,to,castle,epCapture)
        local target=b[to]
        -- The king is never captured; the game ends through checkmate.
        if target and target:lower()=="k" then return end
        table.insert(moves,{from=fr,to=to,castle=castle,epCapture=epCapture})
    end
    local function scan(fr,r,c,directions)
        for _,d in ipairs(directions) do
            local rr,cc=r+d[1],c+d[2]
            while inBounds(rr,cc) do
                local to=cell(rr,cc)
                if color(b[to])==side then break end
                add(fr,to)
                if b[to] then break end
                rr+=d[1];cc+=d[2]
            end
        end
    end
    for i=1,64 do
        local p=b[i]
        if p and color(p)==side then
            local r,c=coords(i)
            local role=p:lower()
            if role=="p" then
                local dr=side=="w" and -1 or 1
                local one=r+dr
                if inBounds(one,c) and not b[cell(one,c)] then
                    add(i,cell(one,c))
                    local start=side=="w" and 7 or 2
                    if r==start and not b[cell(r+2*dr,c)] then add(i,cell(r+2*dr,c)) end
                end
                for _,dc in ipairs({-1,1}) do
                    if inBounds(one,c+dc) then
                        local sq=cell(one,c+dc)
                        if b[sq] and color(b[sq])~=side then add(i,sq)
                        elseif g.ep==sq then add(i,sq,nil,cell(r,c+dc)) end
                    end
                end
            elseif role=="n" then
                for _,d in ipairs(knights) do
                    local rr,cc=r+d[1],c+d[2]
                    if inBounds(rr,cc) and color(b[cell(rr,cc)])~=side then add(i,cell(rr,cc)) end
                end
            elseif role=="b" then scan(i,r,c,dirsBishop)
            elseif role=="r" then scan(i,r,c,dirsRook)
            elseif role=="q" then
                scan(i,r,c,dirsRook);scan(i,r,c,dirsBishop)
            elseif role=="k" then
                for dr=-1,1 do for dc=-1,1 do
                    if not(dr==0 and dc==0) and inBounds(r+dr,c+dc) and color(b[cell(r+dr,c+dc)])~=side then
                        add(i,cell(r+dr,c+dc))
                    end
                end end
                local home=side=="w" and 8 or 1
                local rights=g.castling
                if r==home and c==5 and not inCheck(b,side) then
                    local them=side=="w" and "b" or "w"
                    local rook=side=="w" and "R" or "r"
                    local kingRight=side=="w" and "K" or "k"
                    local queenRight=side=="w" and "Q" or "q"
                    if rights[kingRight] and b[cell(home,8)]==rook
                       and not b[cell(home,6)] and not b[cell(home,7)]
                       and not squareAttacked(b,home,6,them) and not squareAttacked(b,home,7,them) then
                        add(i,cell(home,7),"K")
                    end
                    if rights[queenRight] and b[cell(home,1)]==rook
                       and not b[cell(home,2)] and not b[cell(home,3)] and not b[cell(home,4)]
                       and not squareAttacked(b,home,4,them) and not squareAttacked(b,home,3,them) then
                        add(i,cell(home,3),"Q")
                    end
                end
            end
        end
    end
    return moves
end
local function applyMove(g,move)
    local b=table.clone(g.board)
    local castle=table.clone(g.castling)
    local p=b[move.from]
    local startR,startC=coords(move.from)
    local toR,toC=coords(move.to)
    local taken=b[move.to]
    b[move.to]=p;b[move.from]=nil
    if move.epCapture then b[move.epCapture]=nil end
    if move.castle then
        local rookFrom=cell(startR,move.castle=="K" and 8 or 1)
        local rookTo=cell(startR,move.castle=="K" and 6 or 4)
        b[rookTo]=b[rookFrom];b[rookFrom]=nil
    end
    if p:lower()=="p" and (toR==1 or toR==8) then b[move.to]=color(p)=="w" and "Q" or "q" end
    if p=="K" then castle.K=false;castle.Q=false end
    if p=="k" then castle.k=false;castle.q=false end
    if move.from==cell(8,1) or move.to==cell(8,1) then castle.Q=false end
    if move.from==cell(8,8) or move.to==cell(8,8) then castle.K=false end
    if move.from==cell(1,1) or move.to==cell(1,1) then castle.q=false end
    if move.from==cell(1,8) or move.to==cell(1,8) then castle.k=false end
    local ep=nil
    if p:lower()=="p" and math.abs(toR-startR)==2 then ep=cell(math.floor((startR+toR)/2),startC) end
    local opp=g.turn=="w" and "b" or "w"
    return {board=b,turn=opp,white=g.white,black=g.black,mode=g.mode,castling=castle,ep=ep,ply=g.ply+1,
        version=g.version+1,lastMove={move.from,move.to},ended=false,status="",captured=taken}
end
local function legal(g,side)
    local out={}
    for _,move in ipairs(pseudo(g,side)) do
        local nextG=applyMove(g,move)
        if not inCheck(nextG.board,side) then table.insert(out,move) end
    end
    return out
end
local function endCondition(g)
    local moves=legal(g,g.turn)
    if #moves==0 then
        g.ended=true
        if inCheck(g.board,g.turn) then
            g.status="CHECKMATE · "..(g.turn=="w" and "Black" or "White").." wins!"
        else
            g.status="STALEMATE · draw"
        end
    elseif inCheck(g.board,g.turn) then
        g.status=(g.turn=="w" and "White" or "Black").." is in check"
    else
        g.status=(g.turn=="w" and "White" or "Black").." to move"
    end
end
local function snapshot(g)
    local b={}
    for i=1,64 do b[i]=g.board[i] or "" end
    return {board=b,turn=g.turn,mode=g.mode,status=g.status,white=g.white and g.white.UserId or 0,
        black=g.black and g.black.UserId or 0,ended=g.ended,ply=g.ply,lastMove=g.lastMove,version=g.version,
        check=inCheck(g.board,g.turn)}
end
-- A single, persistent set of 3D pieces follows the SAME authoritative board
-- used by PvP, bot logic, captures, castling and the client's bird's-eye view.
-- Pieces tween between squares instead of deleting/rebuilding on each move.
local physical={folder=nil,bySquare={},version=-1,board=nil}
local MOVE_TIME=.40
local function pieceCFrame(boardTop,square)
    local r,c=coords(square)
    return boardTop.CFrame*CFrame.new((c-4.5)*PieceFactory.Square,boardTop.Size.Y/2+.065,(r-4.5)*PieceFactory.Square)
end
local function physicalFolder(boardTop)
    if not boardTop then return nil end
    local folder=boardTop:FindFirstChild('ChessPieces')
    if folder and physical.folder==folder then return folder end
    if folder then folder:Destroy() end
    folder=Instance.new('Folder')
    folder.Name='ChessPieces';folder.Parent=boardTop
    physical.folder=folder;physical.bySquare={};physical.version=-1
    return folder
end
local function fullRedraw()
    local boardTop=chessPart()
    if not boardTop then return end
    local folder=physicalFolder(boardTop)
    folder:ClearAllChildren()
    physical.bySquare={}
    for ix=1,64 do
        local piece=gameState.board[ix]
        if piece then
            local model=PieceFactory.Create(piece,folder,pieceCFrame(boardTop,ix))
            model:SetAttribute('Square',ix)
            physical.bySquare[ix]=model
        end
    end
    physical.version=gameState.version
end
local function glide(model,cf)
    if model and model.Parent and model.PrimaryPart then
        TweenService:Create(model.PrimaryPart, TweenInfo.new(MOVE_TIME,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{CFrame=cf}):Play()
    end
end
local function performVisualMove(move)
    local boardTop=chessPart()
    if not boardTop then return end
    local folder=physicalFolder(boardTop)
    if physical.version~=gameState.version-1 then fullRedraw();return end
    local moving=physical.bySquare[move.from]
    if not moving then fullRedraw();return end
    local target=physical.bySquare[move.to]
    if target then
        target:Destroy()
        physical.bySquare[move.to]=nil
    end
    if move.epCapture then
        local pawn=physical.bySquare[move.epCapture]
        if pawn then pawn:Destroy(); physical.bySquare[move.epCapture]=nil end
    end
    physical.bySquare[move.from]=nil
    physical.bySquare[move.to]=moving
    moving:SetAttribute('Square',move.to)
    glide(moving,pieceCFrame(boardTop,move.to))
    if move.castle then
        local r=math.floor((move.from-1)/8)+1
        local rf=cell(r,move.castle=='K' and 8 or 1)
        local rt=cell(r,move.castle=='K' and 6 or 4)
        local rook=physical.bySquare[rf]
        if rook then
            physical.bySquare[rf]=nil; physical.bySquare[rt]=rook
            rook:SetAttribute('Square',rt)
            glide(rook,pieceCFrame(boardTop,rt))
        end
    end
    physical.version=gameState.version
    -- Promotion gets a proper queen model once the movement finishes.
    local resulting=gameState.board[move.to]
    if resulting and resulting~=moving:GetAttribute('ChessPiece') then
        local version=gameState.version
        task.delay(MOVE_TIME+.015,function()
            if gameState.version~=version or physical.bySquare[move.to]~=moving then return end
            if moving.Parent then moving:Destroy() end
            local queen=PieceFactory.Create(resulting,folder,pieceCFrame(boardTop,move.to))
            queen:SetAttribute('Square',move.to)
            physical.bySquare[move.to]=queen
        end)
    end
end
local function redrawTable(move)
    if move then performVisualMove(move)
    elseif physical.version~=gameState.version then fullRedraw() end
end
local function broadcast(move)
    redrawTable(move)
    local info=snapshot(gameState)
    for _,p in ipairs(Players:GetPlayers()) do
        if p:GetAttribute('Zone')=='Lobby' then State:FireClient(p,info) end
    end
end
local function fresh()
    return {board=initial(),turn="w",white=nil,black=nil,mode="idle",status="Choose PvP or bot.",
        castling={K=true,Q=true,k=true,q=true},ep=nil,ply=0,version=gameState.version+1,lastMove=nil,ended=false}
end
local function decideBot(g)
    local choices=legal(g,"b")
    if #choices==0 then return nil end
    -- ~600-style casual beginner: frequent mistakes and some free captures.
    -- This is NOT a calibrated external chess engine rating.
    if rng:NextNumber()&lt;.42 then return choices[rng:NextInteger(1,#choices)] end
    local weights={p=1,n=3,b=3.15,r=5,q=9,k=0}
    local best=-math.huge;local candidates={}
    for _,m in ipairs(choices) do
        local target=g.board[m.to]
        local after=applyMove(g,m)
        local score=(target and (weights[target:lower()] or 0)*1.6 or 0)
        if m.epCapture then score = score + 1.5 end
        if m.castle then score = score + 1 end
        if inCheck(after.board,"w") then score = score + 1.5 end
        local r,c=coords(m.to)
        score = score + (3.5-math.abs(c-4.5))*.15
        score = score + rng:NextNumber(-2.8,2.8)
        if score&gt;best then best=score;candidates={m} end
    end
    return candidates[1]
end
local function moveBot(expectedVersion)
    task.delay(.72,function()
        local g=gameState
        if g.version~=expectedVersion or g.mode~="bot" or g.ended or g.turn~="b" then return end
        local move=decideBot(g)
        if not move then endCondition(g);broadcast();return end
        local newer=applyMove(g,move)
        endCondition(newer)
        gameState=newer
        broadcast(move)
    end)
end
Request.OnServerEvent:Connect(function(p,action,from,to)
    if typeof(action)~="string" or not closeEnough(p) then return end
    local now=os.clock()
    if now-(lastAt[p] or -2)&lt;.12 then return end
    lastAt[p]=now
    if action=="View" then
        State:FireClient(p,snapshot(gameState))
        return
    end
    if action=="Bot" then
        if gameState.mode~="idle" and not gameState.ended and (gameState.white~=p or gameState.mode~="bot") then
            State:FireClient(p,snapshot(gameState));return
        end
        gameState=fresh()
        gameState.mode="bot";gameState.white=p;gameState.status="White to move · beginner bot"
        broadcast();return
    end
    if action=="PvP" then
        if gameState.mode=="idle" or gameState.ended then
            gameState=fresh()
            gameState.mode="pvp";gameState.white=p
            gameState.status="Waiting for another player to join as Black..."
        elseif gameState.mode=="pvp" and not gameState.black and gameState.white~=p then
            gameState.black=p;gameState.status="White to move"
        end
        broadcast();return
    end
    if action=="Resign" then
        if gameState.white==p or gameState.black==p then
            gameState.status=p.DisplayName.." resigned. Select a new game."
            gameState.ended=true
            gameState.version+=1
            broadcast()
        end
        return
    end
    if action~="Move" or type(from)~="number" or type(to)~="number" or from%1~=0 or to%1~=0 then return end
    if from&lt;1 or from&gt;64 or to&lt;1 or to&gt;64 or gameState.ended then return end
    local side=gameState.turn
    if gameState.mode=="pvp" and not gameState.black then return end
    if (side=="w" and gameState.white~=p) or (side=="b" and gameState.black~=p) then return end
    for _,move in ipairs(legal(gameState,side)) do
        if move.from==from and move.to==to then
            local g=applyMove(gameState,move)
            endCondition(g)
            gameState=g
            broadcast(move)
            if g.mode=="bot" and g.turn=="b" and not g.ended then moveBot(g.version) end
            return
        end
    end
    State:FireClient(p,snapshot(gameState))
end)
Players.PlayerRemoving:Connect(function(p)
    lastAt[p]=nil
    if gameState.white==p or gameState.black==p then
        gameState=fresh()
        gameState.status="Previous player left. Choose a new game."
        broadcast()
    end
end)

task.defer(function()
    for _=1,20 do
        local boardTop=chessPart()
        if boardTop then
            redrawTable()
            local prompt=boardTop:FindFirstChild("ChessPrompt")
            if not prompt then
                prompt=Instance.new("ProximityPrompt")
                prompt.Name="ChessPrompt"
                prompt.Parent=boardTop
            end
            prompt.ActionText="PLAY CHESS"
            prompt.ObjectText="UPSTAIRS CHESS - BOT OR 2 PLAYERS"
            prompt.HoldDuration=0
            prompt.MaxActivationDistance=17
            prompt.RequiresLineOfSight=false
            prompt.Enabled=true
            if not boardTop:FindFirstChild("V26ChessCue") then
                local tag=Instance.new("BillboardGui")
                tag.Name="V26ChessCue"
                tag.Adornee=boardTop
                tag.AlwaysOnTop=true
                tag.MaxDistance=115
                tag.StudsOffsetWorldSpace=Vector3.new(0,4.1,0)
                tag.Size=UDim2.fromOffset(260,61)
                tag.Parent=boardTop
                local text=Instance.new("TextLabel")
                text.Size=UDim2.fromScale(1,1)
                text.BackgroundColor3=Color3.fromRGB(56,35,24)
                text.BackgroundTransparency=.11
                text.TextColor3=Color3.fromRGB(255,237,199)
                text.Font=Enum.Font.GothamBold
                text.TextScaled=true
                text.Text="CHESS  •  BOT / 2 PLAYERS\nE / TAP TO PLAY"
                text.Parent=tag
                Instance.new("UICorner",text).CornerRadius=UDim.new(0,12)
            end
            if prompt then
                prompt.Triggered:Connect(function(p)
                    if not closeEnough(p) then return end
                    RS:WaitForChild("LashboundV5Remotes"):WaitForChild("Feedback"):FireClient(p,"OpenChess")
                    State:FireClient(p,snapshot(gameState))
                end)
            end
            return
        end
        task.wait(.25)
    end
end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX04017">
      <Properties>
        <string name="Name">LashboundV19LobbyNPCs</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source">-- Three interactive cabin NPCs. Client never grants currency from dialogue.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Feedback=RS:WaitForChild("LashboundV5Remotes"):WaitForChild("Feedback")
local Workspace=game:GetService("Workspace")
local lobby=Workspace:WaitForChild("LashboundLobby")
local palette={
    {name="Mara the Quartermaster",role="WHIP SMITH",pos=Vector3.new(-29,1,-23),color=Color3.fromRGB(156,100,63),action="OpenShop"},
    {name="Elder Rowan",role="BOSS LORE",pos=Vector3.new(24,1,16),color=Color3.fromRGB(81,111,96),action="BossLore"},
    {name="Scout Finn",role="RAID GUIDE",pos=Vector3.new(-20,1,27),color=Color3.fromRGB(116,91,136),action="RaidGuide"},
}
local function part(parent,name,size,pos,color,shape)
    local x=Instance.new("Part")
    x.Name=name;x.Size=size;x.CFrame=CFrame.new(pos);x.Anchored=true
    x.CanCollide=false;x.CanTouch=false;x.CanQuery=false
    x.Material=Enum.Material.SmoothPlastic;x.Color=color;x.CastShadow=false
    if shape then x.Shape=shape end
    x.Parent=parent
    return x
end
for i,info in ipairs(palette) do
    local npc=Instance.new("Model")
    npc.Name="LobbyNPC_"..i
    npc.Parent=lobby
    local p=info.pos
    local skin=Color3.fromRGB(211,168,126)
    local shoes=Color3.fromRGB(54,44,40)
    local torso=part(npc,"Torso",Vector3.new(2.4,2.4,1.2),p+Vector3.new(0,3.1,0),info.color)
    part(npc,"Head",Vector3.new(1.75,1.75,1.6),p+Vector3.new(0,5.25,0),skin,Enum.PartType.Ball)
    part(npc,"Apron",Vector3.new(2.0,1.65,.28),p+Vector3.new(0,2.65,-.72),Color3.fromRGB(84,59,42))
    part(npc,"LeftArm",Vector3.new(.67,2.2,.9),p+Vector3.new(-1.56,3.0,0),skin)
    part(npc,"RightArm",Vector3.new(.67,2.2,.9),p+Vector3.new(1.56,3.0,0),skin)
    part(npc,"LeftLeg",Vector3.new(.86,2.1,1.0),p+Vector3.new(-.58,1.15,0),shoes)
    part(npc,"RightLeg",Vector3.new(.86,2.1,1.0),p+Vector3.new(.58,1.15,0),shoes)
    part(npc,"HatBrim",Vector3.new(2.5,.26,2.2),p+Vector3.new(0,6.22,0),shoes)
    part(npc,"HatTop",Vector3.new(1.6,.73,1.45),p+Vector3.new(0,6.64,0),info.color)
    for side=-1,1,2 do
        part(npc,"Eye"..side,Vector3.new(.18,.18,.12),p+Vector3.new(side*.34,5.35,-.77),Color3.fromRGB(34,28,22),Enum.PartType.Ball)
    end
    local prompt=Instance.new("ProximityPrompt")
    prompt.Name="NPCInteract"
    prompt.ActionText=info.role=="WHIP SMITH" and "Browse whips" or "Talk"
    prompt.ObjectText=info.name
    prompt.MaxActivationDistance=12
    prompt.HoldDuration=0
    prompt.RequiresLineOfSight=false
    prompt.Parent=torso
    prompt.Triggered:Connect(function(player)
        if player:GetAttribute("Zone")~="Lobby" then return end
        local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root or (root.Position-torso.Position).Magnitude&gt;15 then return end
        if info.action=="OpenShop" then
            Feedback:FireClient(player,"OpenShop","Mara: Every whip is different. Choose wisely!")
        elseif info.action=="BossLore" then
            Feedback:FireClient(player,"LobbyDialogue",info.name,{
                "The Colossus falls once... then rises in the color of this land.",
                "Its second form has ranged spells and sweeping shockwaves. Watch the warning lines.",
                "Move out of its marked attacks. The respawn timer begins only after the second defeat."})
        else
            Feedback:FireClient(player,"LobbyDialogue",info.name,{
                "Storm clouds mean the hound raid is coming.",
                "Thirty hounds spawn two minutes into each map. Each is worth one coin.",
                "If you need a break, the lobby is always safe. Try the chess table!"})
        end
    end)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX04122">
      <Properties>
        <string name="Name">LashboundV22GameRoomService</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source">-- LASHBOUND V22: shared upstairs game tables. The server owns every move.
-- Connect Four: 7x6 rules. Battleship: hidden 10x10 fleets, five ships.
-- Pool: lightweight turn-based arcade billiards with server ball physics.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local Workspace=game:GetService("Workspace")
local rng=Random.new()
local remote=RS:FindFirstChild("LashboundGameRoomRequest") or Instance.new("RemoteEvent")
remote.Name="LashboundGameRoomRequest";remote.Parent=RS
local stateRemote=RS:FindFirstChild("LashboundGameRoomState") or Instance.new("RemoteEvent")
stateRemote.Name="LashboundGameRoomState";stateRemote.Parent=RS
local lobby=Workspace:WaitForChild("LashboundLobby")
local names={"ConnectFour","Battleship","PoolA"}
local sessions={}
local cooldown={}
local function tableOf(key) return lobby:FindFirstChild("GameRoom_"..key) end
local function nearby(p,key)
    local tablePart=tableOf(key)
    local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    return p:GetAttribute("Zone")=="Lobby" and root and tablePart
        and (root.Position-tablePart.Position).Magnitude&lt;=33
end
local function session(key)
    if not sessions[key] then sessions[key]={key=key,mode="idle",version=0,turn=1,score={0,0},winner=0} end
    return sessions[key]
end
local function isPool(key) return key=="PoolA" end
local function playerSide(g,p)
    if g.p1==p then return 1 end
    if g.p2==p then return 2 end
    return 0
end
local function publicSnap(g,p)
    local side=playerSide(g,p)
    local s={mode=g.mode,turn=g.turn,winner=g.winner or 0,version=g.version or 0,
        side=side,waiting=g.mode=="waiting",key=g.key,
        white=g.p1 and g.p1.DisplayName or "",black=g.p2 and g.p2.DisplayName or (g.mode=="bot" and "Beginner Bot" or ""),
        score=g.score or {0,0},busy=g.busy or false,notice=g.notice or ""}
    if g.key=="ConnectFour" then
        s.board=g.board or {};s.winning=g.winning or {}
    elseif g.key=="Battleship" then
        local own=side==1 and 1 or side==2 and 2 or 0
        s.enemyMarks=own&gt;0 and g.shots and g.shots[own] or {}
        s.incomingMarks=own&gt;0 and g.shots and g.shots[3-own] or {}
        s.ownFleet=own&gt;0 and g.fleets and g.fleets[own] or {}
        s.shipsLeft=g.hits and {17-g.hits[1],17-g.hits[2]} or {17,17}
    elseif isPool(g.key) then
        s.balls={}
        for _,b in ipairs(g.balls or {}) do
            table.insert(s.balls,{n=b.n,x=b.x,z=b.z,active=b.active})
        end
    end
    return s
end
local function send(g,p,verb)
    if p and p.Parent==Players then stateRemote:FireClient(p,g.key,verb or "State",publicSnap(g,p)) end
end
-- The cabin display mirrors the server-owned Connect Four board.
-- Inactive slots never contain proxy rewards or collision geometry.
local function mirrorFour(g)
    if g.key~="ConnectFour" then return end
    local tablePart=tableOf(g.key)
    if not tablePart then return end
    local folder=tablePart:FindFirstChild("PlacedFourDiscs")
    if not folder then
        folder=Instance.new("Folder")
        folder.Name="PlacedFourDiscs"
        folder.Parent=tablePart
    end
    for row=1,6 do
        for col=1,7 do
            local ix=(row-1)*7+col
            local val=g.board and g.board[ix] or 0
            local disk=folder:FindFirstChild("Disc"..ix)
            if val==0 then if disk then disk:Destroy() end
            else
                if not disk then
                    disk=Instance.new("Part")
                    disk.Name="Disc"..ix
                    disk.Shape=Enum.PartType.Ball
                    disk.Size=Vector3.new(.94,.55,.33)
                    disk.Anchored=true;disk.CanCollide=false;disk.CanTouch=false;disk.CanQuery=false
                    disk.Material=Enum.Material.SmoothPlastic
                    disk.Parent=folder
                end
                disk.Color=val==1 and Color3.fromRGB(237,71,57) or Color3.fromRGB(244,213,68)
                disk.CFrame=CFrame.new(-6+(col-1)*2,18.3+(row-1)*.67,10.19)
            end
        end
    end
end
local function broadcast(g)
    mirrorFour(g)
    g.version=(g.version or 0)+1
    for _,p in ipairs(Players:GetPlayers()) do
        if p:GetAttribute("Zone")=="Lobby" then send(g,p,"State") end
    end
end
local function reset(g,mode,p)
    g.mode=mode;g.p1=p;g.p2=nil;g.turn=1;g.winner=0;g.version=(g.version or 0)+1
    g.notice=mode=="waiting" and "Waiting for another player to join." or "Your turn."
    g.score={0,0};g.busy=false
    g.round=(g.round or 0)+1 -- invalidate any prior physics/AI task on restart
end
-- CONNECT FOUR
local function dropIn(board,col,who)
    if type(col)~="number" or col%1~=0 or col&lt;1 or col&gt;7 then return nil end
    for row=1,6 do
        local i=(row-1)*7+col
        if not board[i] or board[i]==0 then board[i]=who;return row end
    end
    return nil
end
local function fourWin(board,row,col,who)
    for _,d in ipairs({{1,0},{0,1},{1,1},{1,-1}}) do
        local count=1
        for sign=-1,1,2 do
            for k=1,3 do
                local r=row+d[1]*k*sign
                local c=col+d[2]*k*sign
                if r&lt;1 or r&gt;6 or c&lt;1 or c&gt;7 or board[(r-1)*7+c]~=who then break end
                count=count+1
            end
        end
        if count&gt;=4 then return true end
    end
    return false
end
local function fourBotMove(g)
    local options={}
    for _,col in ipairs({4,3,5,2,6,1,7}) do
        local test=table.clone(g.board)
        local row=dropIn(test,col,2)
        if row then
            if fourWin(test,row,col,2) then return col end
            table.insert(options,col)
        end
    end
    for _,col in ipairs(options) do
        local test=table.clone(g.board)
        local row=dropIn(test,col,1)
        if row and fourWin(test,row,col,1) then return col end
    end
    if #options==0 then return nil end
    return options[math.clamp(rng:NextInteger(1,math.min(3,#options)),1,#options)]
end
local function fourPlay(g,col,who)
    local row=dropIn(g.board,col,who)
    if not row then return false end
    if fourWin(g.board,row,col,who) then g.winner=who;g.notice=(who==1 and "Red" or "Yellow").." wins!"
    elseif not table.find(g.board,0) then g.winner=3;g.notice="Draw — board full."
    else g.turn=3-who;g.notice=who==1 and "Yellow's turn." or "Red's turn." end
    broadcast(g)
    return true
end
-- BATTLESHIP
local ships={5,4,3,3,2}
local function fleet()
    local cells={}
    for _,length in ipairs(ships) do
        local placed=false
        for trial=1,250 do
            local horiz=rng:NextInteger(0,1)==0
            local r=rng:NextInteger(1,horiz and 10 or 11-length)
            local c=rng:NextInteger(1,horiz and 11-length or 10)
            local nextCells={}
            local okay=true
            for k=0,length-1 do
                local rr=r+(horiz and 0 or k)
                local cc=c+(horiz and k or 0)
                local i=(rr-1)*10+cc
                if cells[i] then okay=false;break end
                table.insert(nextCells,i)
            end
            if okay then
                for _,i in ipairs(nextCells) do cells[i]=1 end
                placed=true;break
            end
        end
        if not placed then error("Unable to place a Battleship vessel") end
    end
    return cells
end
local function shipShot(g,who,cell)
    if type(cell)~="number" or cell%1~=0 or cell&lt;1 or cell&gt;100 then return false end
    if g.shots[who][cell] then return false end
    local opponent=3-who
    local hit=g.fleets[opponent][cell]==1
    g.shots[who][cell]=hit and 2 or 1
    if hit then g.hits[opponent]=g.hits[opponent]+1 end
    g.notice=hit and "Direct hit!" or "Miss!"
    if g.hits[opponent]&gt;=17 then
        g.winner=who;g.notice=(who==1 and "Admiral One" or "Admiral Two").." wins the sea!"
    else
        g.turn=opponent
    end
    broadcast(g)
    return true
end
local function shipBotPick(g)
    local shot=g.shots[2]
    local candidates={}
    for i,val in pairs(shot) do
        if val==2 then
            local r=math.floor((i-1)/10)+1
            local c=(i-1)%10+1
            for _,v in ipairs({{1,0},{-1,0},{0,1},{0,-1}}) do
                local rr=r+v[1];local cc=c+v[2]
                if rr&gt;=1 and rr&lt;=10 and cc&gt;=1 and cc&lt;=10 then
                    local n=(rr-1)*10+cc
                    if not shot[n] then table.insert(candidates,n) end
                end
            end
        end
    end
    if #candidates&gt;0 and rng:NextNumber()&lt;.78 then return candidates[rng:NextInteger(1,#candidates)] end
    for _=1,120 do
        local i=rng:NextInteger(1,100)
        if not shot[i] then return i end
    end
    for i=1,100 do if not shot[i] then return i end end
    return nil
end
-- POOL, normalized 2:1 tabletop. Six pockets, equal-mass ball collisions.
local pockets={{-.91,-.43},{0,-.43},{.91,-.43},{-.91,.43},{0,.43},{.91,.43}}
local function initBalls()
    local b={{n=0,x=-.54,z=0,active=true,vx=0,vz=0}}
    local n=1
    for row=0,4 do
        for j=0,row do
            local id=n
            if row==2 and j==1 then id=8 end
            if row&gt;=2 and j==1 and n==8 then id=n end
            local x=.30+row*.080
            local z=(j-row*.5)*.081
            table.insert(b,{n=n,x=x,z=z,active=true,vx=0,vz=0})
            n=n+1
        end
    end
    return b
end
local function poolBallPosition(top,b)
    return top.CFrame:PointToWorldSpace(Vector3.new(b.x*9.8,top.Size.Y/2+.53,b.z*9.0))
end
local function ensurePoolModels(g)
    local top=tableOf(g.key)
    if not top then return end
    if g.physical and g.physical.Parent then return end
    local folder=Instance.new("Folder")
    folder.Name="PoolBalls";folder.Parent=top
    g.physical=folder;g.models={}
    local colorList={Color3.fromRGB(249,242,226),Color3.fromRGB(240,203,71),Color3.fromRGB(80,125,221),Color3.fromRGB(216,65,69),
        Color3.fromRGB(138,82,187),Color3.fromRGB(240,140,54),Color3.fromRGB(82,176,94),Color3.fromRGB(153,59,61),Color3.fromRGB(28,32,43),
        Color3.fromRGB(239,203,92),Color3.fromRGB(76,115,221),Color3.fromRGB(229,69,72),Color3.fromRGB(138,75,200),Color3.fromRGB(240,153,66),
        Color3.fromRGB(94,171,90),Color3.fromRGB(159,66,70)}
    for _,b in ipairs(g.balls) do
        local ball=Instance.new("Part")
        ball.Name="PoolBall_"..b.n;ball.Shape=Enum.PartType.Ball
        ball.Size=Vector3.new(.76,.76,.76)
        ball.Anchored=true;ball.CanCollide=false;ball.CanTouch=false;ball.CanQuery=false
        ball.Material=Enum.Material.SmoothPlastic
        ball.Color=colorList[b.n+1] or Color3.new(1,1,1)
        ball.CFrame=CFrame.new(poolBallPosition(top,b));ball.Parent=folder
        g.models[b.n]=ball
        if b.n~=0 then
            local tag=Instance.new("BillboardGui");tag.Name="Number";tag.Size=UDim2.fromOffset(25,25)
            tag.AlwaysOnTop=true;tag.StudsOffsetWorldSpace=Vector3.new(0,.4,0);tag.Parent=ball
            local txt=Instance.new("TextLabel");txt.Size=UDim2.fromScale(1,1);txt.BackgroundTransparency=1
            txt.Font=Enum.Font.GothamBold;txt.TextScaled=true;txt.TextColor3=Color3.new(1,1,1)
            txt.TextStrokeTransparency=.16;txt.Text=tostring(b.n);txt.Parent=tag
        end
    end
end
local function syncPool(g)
    local top=tableOf(g.key)
    if not top or not g.models then return end
    for _,b in ipairs(g.balls or {}) do
        local model=g.models[b.n]
        if model and model.Parent then
            model.Transparency=b.active and 0 or 1
            model.CFrame=CFrame.new(poolBallPosition(top,b))
        end
    end
end
local function simulatePool(g,angle,power,who)
    if g.busy then return end
    g.busy=true
    local round=g.round
    local cue=g.balls[1]
    if not cue.active then cue.active=true;cue.x=-.52;cue.z=0 end
    local a=math.rad(angle)
    local speed=.25+2.3*power/100
    cue.vx=math.cos(a)*speed
    cue.vz=math.sin(a)*speed
    broadcast(g)
    task.spawn(function()
        local potted=0
        for frame=1,220 do
            if g.round~=round or g.mode=="idle" then return end
            local still=false
            for _,b in ipairs(g.balls) do
                if b.active then
                    local vx,vz=b.vx,b.vz
                    if vx*vx+vz*vz&gt;.0009 then still=true end
                    b.x=b.x+vx*.033;b.z=b.z+vz*.033
                    b.vx=b.vx*.975;b.vz=b.vz*.975
                    if math.abs(b.vx)&lt;.015 then b.vx=0 end
                    if math.abs(b.vz)&lt;.015 then b.vz=0 end
                    local pocketed=false
                    for _,pk in ipairs(pockets) do
                        local dx,dz=b.x-pk[1],b.z-pk[2]
                        if dx*dx+dz*dz&lt;.0144 then pocketed=true;break end
                    end
                    if pocketed then
                        b.active=false;b.vx=0;b.vz=0
                        if b.n~=0 then
                            potted+=1
                            g.score[who]=g.score[who]+(b.n==8 and 3 or 1)
                        end
                    else
                        if b.x&gt;.91 then b.x=.91;b.vx=-math.abs(b.vx)*.78 end
                        if b.x&lt;-.91 then b.x=-.91;b.vx=math.abs(b.vx)*.78 end
                        if b.z&gt;.43 then b.z=.43;b.vz=-math.abs(b.vz)*.78 end
                        if b.z&lt;-.43 then b.z=-.43;b.vz=math.abs(b.vz)*.78 end
                    end
                end
            end
            -- Pairwise equal-mass collisions, with gentle restitution.
            for i=1,#g.balls do
                local aBall=g.balls[i]
                if aBall.active then
                    for j=i+1,#g.balls do
                        local bBall=g.balls[j]
                        if bBall.active then
                            local dx=bBall.x-aBall.x;local dz=bBall.z-aBall.z
                            local d2=dx*dx+dz*dz
                            if d2&gt;.000001 and d2&lt;.00518 then
                                local dist=math.sqrt(d2)
                                local nx,nz=dx/dist,dz/dist
                                local overlap=(.072-dist)*.5
                                aBall.x-=nx*overlap;aBall.z-=nz*overlap
                                bBall.x+=nx*overlap;bBall.z+=nz*overlap
                                local relative=(aBall.vx-bBall.vx)*nx+(aBall.vz-bBall.vz)*nz
                                if relative&gt;0 then
                                    local impulse=relative*.92
                                    aBall.vx-=impulse*nx;aBall.vz-=impulse*nz
                                    bBall.vx+=impulse*nx;bBall.vz+=impulse*nz
                                end
                            end
                        end
                    end
                end
            end
            if frame%2==0 then syncPool(g) end
            -- Send throttled snapshots so the top-down UI also tracks moving balls.
            if frame%9==0 then broadcast(g) end
            if not still and frame&gt;12 then break end
            task.wait(.033)
            if g.mode=="idle" or not g.physical or not g.physical.Parent then break end
        end
        if g.round~=round or g.mode=="idle" then return end
        if not cue.active then cue.active=true;cue.x=-.55;cue.z=0 end
        for _,b in ipairs(g.balls) do b.vx=0;b.vz=0 end
        syncPool(g)
        local left=0
        for _,b in ipairs(g.balls) do if b.n&gt;0 and b.active then left=left+1 end end
        if left==0 then
            g.winner=g.score[1]==g.score[2] and 3 or g.score[1]&gt;g.score[2] and 1 or 2
            g.notice="Rack cleared! "..(g.winner==3 and "Tie game." or "Player "..g.winner.." wins.")
        else
            g.turn=3-who
            g.notice=(potted&gt;0 and ("Pocketed "..potted.." balls! ") or "No balls pocketed. ").."Next turn."
        end
        g.busy=false
        broadcast(g)
        if g.mode=="bot" and g.turn==2 and g.winner==0 then
            task.delay(.65,function()
                if g.mode=="bot" and g.turn==2 and not g.busy then
                    local target=nil
                    for _,b in ipairs(g.balls) do
                        if b.n&gt;0 and b.active then
                            if not target or (b.x-cue.x)^2+(b.z-cue.z)^2&lt;(target.x-cue.x)^2+(target.z-cue.z)^2 then target=b end
                        end
                    end
                    if target then
                        local angle2=math.deg(math.atan2(target.z-cue.z,target.x-cue.x))+rng:NextNumber(-17,17)
                        simulatePool(g,angle2,rng:NextInteger(55,88),2)
                    end
                end
            end)
        end
    end)
end
local function start(g,mode,p)
    if g.busy then return end
    -- Only the current host may restart an occupied table, including finished games.
    if g.mode~="idle" and g.p1~=p then return end
    reset(g,mode,p)
    if g.key=="ConnectFour" then
        g.board=table.create(42,0)
    elseif g.key=="Battleship" then
        g.fleets={fleet(),fleet()};g.shots={{},{}};g.hits={0,0}
    elseif isPool(g.key) then
        if g.physical and g.physical.Parent then g.physical:Destroy() end
        g.physical=nil;g.balls=initBalls()
        ensurePoolModels(g);syncPool(g)
    end
    broadcast(g)
end
local function getReady(g,p)
    if g.mode~="waiting" or g.p1==p or g.p2~=nil then return end
    if not g.p1 or g.p1.Parent~=Players then
        g.round=(g.round or 0)+1
        g.mode="idle";g.p1=nil;g.p2=nil;g.busy=false
        g.notice="Host disconnected. Table ready for a new match."
        broadcast(g)
        return
    end
    g.p2=p;g.mode="pvp";g.notice="Both players ready! Player One goes first."
    broadcast(g)
end
local function doBotTurn(g, expectedRound)
    -- A delayed bot move must never affect a restarted match.
    if g.round~=expectedRound then return end
    if g.mode~="bot" or g.turn~=2 or g.winner~=0 then return end
    if g.key=="ConnectFour" then
        local col=fourBotMove(g)
        if col then fourPlay(g,col,2) end
    elseif g.key=="Battleship" then
        local i=shipBotPick(g)
        if i then shipShot(g,2,i) end
    end
end
remote.OnServerEvent:Connect(function(p,key,action,arg)
    if type(key)~="string" or not table.find(names,key) or type(action)~="string" then return end
    if not nearby(p,key) then return end
    local now=os.clock()
    if now-(cooldown[p] or 0)&lt;.11 then return end
    cooldown[p]=now
    local g=session(key)
    if action=="Open" then send(g,p,"Open");return end
    if action=="StartBot" or action=="HostPvP" then
        start(g,action=="StartBot" and "bot" or "waiting",p)
    elseif action=="Join" then
        getReady(g,p)
    elseif action=="Move" and g.winner==0 and not g.busy then
        local who=playerSide(g,p)
        if who~=g.turn or (g.mode~="bot" and g.mode~="pvp") then return end
        if g.key=="ConnectFour" then
            if typeof(arg)=="number" then
                if fourPlay(g,arg,who) and g.mode=="bot" and g.turn==2 and g.winner==0 then
                    local expectedRound=g.round
                    task.delay(.55,function() doBotTurn(g,expectedRound) end)
                end
            end
        elseif g.key=="Battleship" then
            if typeof(arg)=="number" then
                if shipShot(g,who,arg) and g.mode=="bot" and g.turn==2 and g.winner==0 then
                    local expectedRound=g.round
                    task.delay(.72,function() doBotTurn(g,expectedRound) end)
                end
            end
        elseif isPool(key) then
            if typeof(arg)=="table" and typeof(arg.angle)=="number" and typeof(arg.power)=="number" and
                arg.angle==arg.angle and arg.power==arg.power and math.abs(arg.angle)&lt;math.huge and math.abs(arg.power)&lt;math.huge and arg.angle&gt;=-360 and arg.angle&lt;=360 and
                arg.power&gt;=10 and arg.power&lt;=100 then
                simulatePool(g,arg.angle,arg.power,who)
            end
        end
    elseif action=="Exit" then
        send(g,p,"Close")
    end
end)
for _,key in ipairs(names) do
    local top=tableOf(key)
    if top then
        -- Repair missing prompts in older saves and show unmistakable table cues.
        local prompt=top:FindFirstChildOfClass("ProximityPrompt")
        if not prompt then
            prompt=Instance.new("ProximityPrompt")
            prompt.Name="V26GamePrompt"
            prompt.Parent=top
        end
        prompt.ActionText="PLAY GAME"
        prompt.ObjectText=(key=="ConnectFour" and "CONNECT FOUR") or
            (key=="Battleship" and "BATTLESHIP") or "POOL"
        prompt.HoldDuration=0
        prompt.MaxActivationDistance=17
        prompt.RequiresLineOfSight=false
        prompt.Enabled=true
        local sign=top:FindFirstChild("LashboundGameCue")
        if not sign then
            sign=Instance.new("BillboardGui")
            sign.Name="LashboundGameCue"
            sign.Adornee=top
            sign.AlwaysOnTop=true
            sign.MaxDistance=115
            sign.StudsOffsetWorldSpace=Vector3.new(0,3.4,0)
            sign.Size=UDim2.fromOffset(260,62)
            sign.Parent=top
            local label=Instance.new("TextLabel")
            label.Name="Cue"
            label.Size=UDim2.fromScale(1,1)
            label.BackgroundColor3=Color3.fromRGB(57,35,24)
            label.BackgroundTransparency=.12
            label.TextColor3=Color3.fromRGB(255,233,185)
            label.TextStrokeTransparency=.45
            label.Font=Enum.Font.GothamBold
            label.TextScaled=true
            label.TextWrapped=true
            label.Text=prompt.ObjectText.."\nE / TAP TO PLAY"
            label.Parent=sign
            Instance.new("UICorner",label).CornerRadius=UDim.new(0,12)
            local border=Instance.new("UIStroke")
            border.Color=Color3.fromRGB(235,186,103)
            border.Thickness=1.7
            border.Parent=label
        end
        prompt.Triggered:Connect(function(player)
            if nearby(player,key) then send(session(key),player,"Open") end
        end)
    else
        warn("[Lashbound Games] Missing upstairs table: "..key)
    end
end
Players.PlayerRemoving:Connect(function(p)
    cooldown[p]=nil
    for _,g in pairs(sessions) do
        if g.p1==p or g.p2==p then
            local remaining=g.p1==p and g.p2 or g.p1
            g.round=(g.round or 0)+1 -- cancel pending bot moves and pool simulation
            g.version=(g.version or 0)+1
            g.winner=0;g.mode="idle";g.busy=false;g.p1=nil;g.p2=nil
            g.notice="A player left. Table ready for a new match."
            if g.physical and g.physical.Parent then g.physical:Destroy() end
            g.physical=nil
            broadcast(g)
            if remaining and remaining.Parent==Players then send(g,remaining) end
        end
    end
end)
