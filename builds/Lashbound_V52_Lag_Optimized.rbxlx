    stat.ZIndex=23
    local buy=button(card,"Equip",cfg.Legendary and "WHEEL 1%" or "◈ "..cfg.Price,UDim2.new(1,-132,.5,-20),UDim2.fromOffset(122,40),Color3.fromRGB(59,111,118))
